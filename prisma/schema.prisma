generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// ///////////////////
/// ////USER MODEL
/// //////////////////
model User {
  id           String    @id @default(cuid())
  username     String?   @unique
  email        String    @unique
  passwordHash String
  role         String    @default("admin")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  otps         Otp[]
  sessions     Session[]
}

/// ///////////////////
/// ////OTP MODEL
/// //////////////////
model Otp {
  id        String   @id @default(cuid())
  userId    String
  code      String
  type      String   @default("login")
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// ///////////////////
/// ////SESSION MODEL
/// //////////////////
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// ////////////////////////////////////////////////LOCATION MODELS START HERE///////////////////////////////////////////////////

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model ContactImport {
  id           String         @id @default(cuid())

  fileName     String

  totalRows    Int
  successRows  Int            @default(0)
  failedRows   Int            @default(0)

  failedFile   String?

  status       ImportStatus   @default(PROCESSING)

  contacts     Contact[]

  errors       ContactImportError[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ContactImportError {
  id           String   @id @default(cuid())

  importId     String

  rowNumber    Int

  errorMessage String

  rawData      Json

  import       ContactImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@index([importId])
}

model State {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  districts District[]
}

model District {
  id        String   @id @default(cuid())
  name      String
  stateId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blocks    Block[]
  state     State    @relation(fields: [stateId], references: [id])
  nacs      NAC[]

  @@unique([name, stateId])
  @@index([stateId])
}

model Block {
  id         String    @id @default(cuid())
  name       String
  districtId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  district   District  @relation(fields: [districtId], references: [id])
  contacts   Contact[]
  gps        GP[]

  @@unique([name, districtId])
  @@index([districtId])
}

model NAC {
  id         String    @id @default(cuid())
  name       String
  districtId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  contacts   Contact[]
  district   District  @relation(fields: [districtId], references: [id])
  wards      Ward[]

  @@unique([name, districtId])
  @@index([districtId])
}

model GP {
  id        String    @id @default(cuid())
  name      String
  blockId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
  block     Block     @relation(fields: [blockId], references: [id])
  villages  Village[]

  @@unique([name, blockId])
  @@index([blockId])
}

model Village {
  id        String    @id @default(cuid())
  name      String
  gpId      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
  gp        GP        @relation(fields: [gpId], references: [id])
  wards     Ward[]

  @@unique([name, gpId])
  @@index([gpId])
}

model Ward {
  id        String    @id @default(cuid())
  name      String
  villageId String?
  nacId     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  booths    Booth[]
  contacts  Contact[]
  nac       NAC?      @relation(fields: [nacId], references: [id])
  village   Village?  @relation(fields: [villageId], references: [id])

  @@index([villageId])
  @@index([nacId])
}

model Booth {
  id        String    @id @default(cuid())
  name      String
  wardId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ward      Ward      @relation(fields: [wardId], references: [id])
  contacts  Contact[]

  @@unique([name, wardId])
  @@index([wardId])
}

model Contact {
  id              String   @id @default(cuid())

  name            String

  profilePicture  String?

  mobile          String

  alternateMobile String?

  email           String?

  designation     String?

  address         String?

  nacId           String?

  blockId         String?

  gpId            String?

  villageId       String?

  wardId          String?

  boothId         String?

  importId        String?

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

  //------------------------
  // Relations
  //------------------------

  block           Block?   @relation(fields: [blockId], references: [id])

  booth           Booth?   @relation(fields: [boothId], references: [id])

  gp              GP?      @relation(fields: [gpId], references: [id])

  nac             NAC?     @relation(fields: [nacId], references: [id])

  village         Village? @relation(fields: [villageId], references: [id])

  ward            Ward?    @relation(fields: [wardId], references: [id])

  import          ContactImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  //------------------------
  // Indexes
  //------------------------

  @@index([mobile])

  @@index([name])

  @@index([importId])

  @@index([nacId])

  @@index([blockId])

  @@index([gpId])

  @@index([villageId])

  @@index([wardId])

  @@index([boothId])
}